# ====================================================================
# Configuração de Provedor de LLM para o CrewAI
# Insira a chave de API do provedor que você deseja utilizar:
# ====================================================================

# Opção 1: Google Gemini (Recomendado - modelo rápido e gratuito via Google AI Studio)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-1.5-flash

# Opção 2: OpenAI (GPT-4o / GPT-4o-mini)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opção 3: Groq (Llama-3.3 ultra rápido e gratuito)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile

# URL padrão para testes (8080 = LlamaFirewall protegido, 8000 = Alvo direto desprotegido)
TARGET_URL=http://localhost:8080
